# Telegram Bot Token
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Whisper API Configuration (prefix: WHISPER_)
WHISPER_API_BASE_URL="http://localhost:8000/v1"
WHISPER_API_KEY="your_api_key_here"
WHISPER_MODEL="whisper-1"
WHISPER_PROMPT=""

# File Processing (prefix: FILES_)
FILES_MAX_FILE_SIZE_MB=25
# Use forward slashes even on Windows (e.g. "C:/tmp/")
FILES_TEMP_DIR_PATH="temp"
FILES_ALLOWED_AUDIO_EXTENSIONS=".mp3,.wav,.m4a,.flac,.aac,.opus,.ogg,.wma,.aiff"
FILES_ALLOWED_VIDEO_EXTENSIONS=".mp4,.webm,.mkv,.mov,.avi,.flv,.m4v,.3gp,.ts"
# Set to "true" to keep downloaded/converted files in temp dir after transcription
FILES_KEEP_TEMP_FILES="false"

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
